rules_version = '2';service cloud.firestore {match /databases/{database}/documents {function signed(){return request.auth!=null;}function admin(){return signed()&&request.auth.token.admin==true;}match /users/{uid} {allow read: if signed();allow create,delete: if false;allow update: if admin()||(signed()&&request.auth.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));match /tokens/{id}{allow read,delete:if admin()||request.auth.uid==uid;allow create:if signed()&&request.auth.uid==uid;}}match /groupMessages/{id}{allow read:if signed();allow create:if signed()&&request.resource.data.senderId==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=4000;allow delete:if admin();allow update:if false;}match /dmThreads/{thread}{function participant(){return signed()&&request.auth.uid in resource.data.participants;}allow read:if participant()||admin();allow create:if signed()&&request.auth.uid in request.resource.data.participants&&request.resource.data.participants.size()==2;allow update:if participant()||admin();allow delete:if admin();match /messages/{id}{function member(){return signed()&&request.auth.uid in get(/databases/$(database)/documents/dmThreads/$(thread)).data.participants;}allow read:if member()||admin();allow create:if member()&&request.resource.data.senderId==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=4000;allow delete:if admin();allow update:if false;}}}}